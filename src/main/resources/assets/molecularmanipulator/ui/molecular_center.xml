        <button id="legacy-update" class="placed compact-button legacy-control"
                style="left: 210; top: 239; width: 100"/>
        <button id="legacy-keep" class="placed compact-button legacy-control"
                style="left: 314; top: 239; width: 100"/>
    </root>
</ldlib2-ui>
