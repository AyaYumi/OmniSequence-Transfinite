        <button id="color-3-0" class="placed compact-button color-control" style="left: 323; top: 144; width: 27" text="R"/>
        <button id="color-3-1" class="placed compact-button color-control" style="left: 353; top: 144; width: 27" text="G"/>
        <button id="color-3-2" class="placed compact-button color-control" style="left: 383; top: 144; width: 27" text="B"/>
        <button id="color-4-0" class="placed compact-button color-control" style="left: 323; top: 176; width: 27" text="R"/>
        <button id="color-4-1" class="placed compact-button color-control" style="left: 353; top: 176; width: 27" text="G"/>
        <button id="color-4-2" class="placed compact-button color-control" style="left: 383; top: 176; width: 27" text="B"/>
        <button id="color-reset" class="placed compact-button color-control"
